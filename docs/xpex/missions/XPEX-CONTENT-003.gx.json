{
  "mission_id": "XPEX-CONTENT-003",
  "title": "AI Video Lesson Factory",
  "owner": "GX",
  "status": "IMPLEMENTATION_IN_PROGRESS",
  "objective": "Generate a resumable audiovisual package for approved course lessons without ever publishing AI-generated video automatically.",
  "pipeline": [
    "COURSE_APPROVED",
    "VIDEO_SCRIPT",
    "STORYBOARD",
    "NARRATION",
    "ASSETS",
    "VIDEO_DRAFT",
    "MULTIMODAL_REVIEW",
    "HUMAN_APPROVAL",
    "ATTACHMENT_TO_LEARNHOUSE",
    "HUMAN_PUBLISH"
  ],
  "batch_mode": {
    "target_lessons": 24,
    "initial_concurrency": 3,
    "resumable": true,
    "retry_failed_only": true
  },
  "job_states": [
    "QUEUED",
    "SCRIPTING",
    "STORYBOARDING",
    "NARRATING",
    "ASSET_GENERATION",
    "RENDERING",
    "REVIEWING",
    "AWAITING_HUMAN_APPROVAL",
    "APPROVED",
    "ATTACHED",
    "PUBLISHED",
    "FAILED",
    "CANCELLED"
  ],
  "server_side_model_registry": [
    "XPEX_HF_VIDEO_MODEL",
    "XPEX_HF_IMAGE_MODEL",
    "XPEX_HF_TTS_MODEL",
    "XPEX_HF_STT_MODEL",
    "XPEX_HF_MULTIMODAL_REVIEW_MODEL"
  ],
  "implemented_provider_adapters": [
    "HF_IMAGE",
    "HF_TTS",
    "HF_VIDEO_CLIP",
    "HF_STT",
    "HF_MULTIMODAL_REVIEW"
  ],
  "transactional_worker": {
    "claim_strategy": "FOR UPDATE SKIP LOCKED",
    "lease_seconds_default": 300,
    "max_attempts_default": 5,
    "checkpoint_after_each_stage": true,
    "resume_from_last_durable_stage": true,
    "provider_body_persisted_on_error": false,
    "worker_terminal_boundary": "AWAITING_HUMAN_APPROVAL",
    "worker_can_approve": false,
    "worker_can_attach": false,
    "worker_can_publish": false
  },
  "hard_gates": {
    "provider_secrets_browser_exposed": false,
    "automatic_video_approval": false,
    "automatic_learnhouse_publish": false,
    "human_approval_required": true,
    "separate_human_publish_required": true,
    "edit_invalidates_approval": true,
    "blocker_review_disables_approval": true,
    "attachment_is_unpublished": true,
    "idempotent_attachment_required": true,
    "cross_org_access_forbidden": true
  },
  "learnhouse_contract": {
    "activity_type": "TYPE_VIDEO",
    "preferred_subtype": "SUBTYPE_VIDEO_HOSTED",
    "required_content_field": "filename",
    "published_on_attachment": false,
    "hosted_payload_audited": true
  },
  "programming_lessons": {
    "deterministic_code_capture_required": true,
    "generative_fake_code_ui_forbidden": true,
    "composition_layer": "FFmpeg/Remotion-equivalent",
    "browser_or_terminal_capture": "real execution preferred"
  },
  "multimodal_review_checks": [
    "narration matches lesson",
    "factual and code correctness",
    "audio/video synchronization",
    "caption accuracy",
    "no clipped text",
    "no hallucinated UI presented as real",
    "minimum media quality",
    "asset and model license compatibility",
    "no credentials, secrets or private data in frames/audio"
  ],
  "remaining_gates": [
    "select and validate production Hugging Face model ids",
    "real Hugging Face provider smoke test",
    "storage upload adapter",
    "render composition pipeline",
    "caption artifact production",
    "native LearnHouse media upload",
    "batch progress review approval UI",
    "first real lesson end-to-end smoke"
  ],
  "definition_of_done": [
    "persistent resumable batch jobs",
    "24-lesson batch planning",
    "revision plus content hash per lesson video manifest",
    "provider registry server-side only",
    "multimodal review evidence persisted",
    "human approval bound to revision and hash",
    "native LearnHouse video attachment created unpublished",
    "separate human publish action",
    "idempotency and concurrency tests",
    "API and web CI green",
    "Railway production success",
    "one real provider smoke test with no automatic publication"
  ]
}
