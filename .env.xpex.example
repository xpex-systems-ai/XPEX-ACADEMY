# XpeX Academy deployment example — placeholders only, no real secrets.
LEARNHOUSE_SITE_NAME=XpeX Academy
LEARNHOUSE_SITE_DESCRIPTION=Plataforma Global de Desenvolvimento Profissional com Inteligência Artificial.
LEARNHOUSE_CONTACT_EMAIL=contato@xpex.academy
LEARNHOUSE_ENV=prod
LEARNHOUSE_DEVELOPMENT_MODE=false
LEARNHOUSE_TENANCY=single
# REQUIRED IN PRODUCTION:
# Generate a real secret outside Git with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit real secrets.
LEARNHOUSE_AUTH_JWT_SECRET_KEY=
LEARNHOUSE_SQL_CONNECTION_STRING=CHANGE_ME_POSTGRES_URL
LEARNHOUSE_REDIS_CONNECTION_STRING=CHANGE_ME_REDIS_URL
LEARNHOUSE_IS_AI_ENABLED=false
LEARNHOUSE_AI_PROVIDER=google
LEARNHOUSE_AI_API_KEY=
LEARNHOUSE_GEMINI_API_KEY=
LEARNHOUSE_EMAIL_PROVIDER=smtp
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=
