# XpeX Academy deployment example — placeholders only, no real secrets.
LEARNHOUSE_SITE_NAME=XpeX Academy
LEARNHOUSE_SITE_DESCRIPTION=Plataforma Global de Desenvolvimento Profissional com Inteligência Artificial.
LEARNHOUSE_CONTACT_EMAIL=contato@xpex.academy
LEARNHOUSE_ENV=prod
LEARNHOUSE_DEVELOPMENT_MODE=false
LEARNHOUSE_TENANCY=single
# REQUIRED IN PRODUCTION:
# Generate a real secret outside Git with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit real secrets.
LEARNHOUSE_AUTH_JWT_SECRET_KEY=
LEARNHOUSE_SQL_CONNECTION_STRING=CHANGE_ME_POSTGRES_URL
LEARNHOUSE_REDIS_CONNECTION_STRING=CHANGE_ME_REDIS_URL
LEARNHOUSE_IS_AI_ENABLED=false
LEARNHOUSE_AI_PROVIDER=google
LEARNHOUSE_AI_API_KEY=
LEARNHOUSE_GEMINI_API_KEY=
# Production password recovery uses Brevo's HTTPS transactional API.
LEARNHOUSE_EMAIL_PROVIDER=brevo
LEARNHOUSE_BREVO_API_KEY=CHANGE_ME_BREVO_API_KEY
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=

# XPeX Content Studio — server-side only. Never expose these with NEXT_PUBLIC_*.
OPENROUTER_API_KEY=
HF_TOKEN=
XPEX_OPENROUTER_COURSE_MODEL=openrouter/auto
XPEX_HF_REVIEW_MODEL=openai/gpt-oss-120b:cheapest

# XPeX Mercado Pago Financial Engine — server-side secrets only.
# Configure real values in Railway/provider secret management, never in Git.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_INTEGRATOR_ID=
# Canonical HTTPS callback, e.g. https://<api-domain>/api/webhooks/mercadopago
MERCADOPAGO_NOTIFICATION_URL=

# Non-production pilot bootstrap only. Keep false in provider environments.
ALLOW_PILOT_BOOTSTRAP=false
XPEX_PILOT_ADMIN_USERNAME=xpex-admin-test
XPEX_PILOT_ADMIN_EMAIL=
XPEX_PILOT_ADMIN_PASSWORD=
XPEX_PILOT_TEACHER_USERNAME=xpex-teacher-test
XPEX_PILOT_TEACHER_EMAIL=
XPEX_PILOT_TEACHER_PASSWORD=
XPEX_PILOT_STUDENT_USERNAME=xpex-student-test
XPEX_PILOT_STUDENT_EMAIL=
XPEX_PILOT_STUDENT_PASSWORD=
