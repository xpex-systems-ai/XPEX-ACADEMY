{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "bun install && cd apps/web && bun install --frozen-lockfile",
  "buildCommand": "cd apps/web && bun run build",
  "outputDirectory": "apps/web/.next",
  "github": {
    "autoJobCancelation": true
  }
}
