# XPEX Academy staging environment template.
# Copy to .env.staging locally or map each variable in Secret Manager/Cloud Run.
# Never commit real secrets.

# Google Cloud / deployment metadata
# Public interface names. The scripts also accept the legacy aliases PROJECT_ID,
# REGION, SERVICE_NAME, CLOUD_RUN_SERVICE_ACCOUNT and GCS_BUCKET.
GCP_PROJECT_ID=xpex-staging-project
GCP_REGION=us-central1
ARTIFACT_REPOSITORY=xpex-academy-staging
CLOUD_RUN_SERVICE=xpex-academy-staging
IMAGE_NAME=xpex-academy-api
CLOUD_RUN_SA=xpex-academy-staging-runner@xpex-staging-project.iam.gserviceaccount.com
CLOUD_SQL_INSTANCE=xpex-staging-project:us-central1:xpex-academy-staging-db
VPC_CONNECTOR=xpex-academy-staging-connector
STAGING_BUCKET=xpex-academy-staging-media

# Runtime profile
LEARNHOUSE_ENV=staging
LEARNHOUSE_DEVELOPMENT_MODE=false
LEARNHOUSE_SITE_NAME="XpeX Academy Staging"
LEARNHOUSE_SITE_DESCRIPTION="Staging environment for XpeX Academy."
LEARNHOUSE_CONTACT_EMAIL=staging-ops@example.com
LEARNHOUSE_DOMAIN=staging-api.example.com
LEARNHOUSE_FRONTEND_DOMAIN=staging.example.com
LEARNHOUSE_SSL=true
LEARNHOUSE_PORT=8080
LEARNHOUSE_TENANCY=single
LEARNHOUSE_ALLOWED_ORIGINS=https://staging.example.com
LEARNHOUSE_ALLOWED_REGEXP=^https://staging\.example\.com$
LEARNHOUSE_COOKIE_DOMAIN=
LEARNHOUSE_CONTENT_DELIVERY_TYPE=s3api
LEARNHOUSE_S3_API_BUCKET_NAME=xpex-academy-staging-media
LEARNHOUSE_S3_API_ENDPOINT_URL=https://storage.googleapis.com

# Required secrets; store in Google Secret Manager and inject into Cloud Run.
LEARNHOUSE_AUTH_JWT_SECRET_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql+asyncpg://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://REDIS_PRIVATE_IP:6379/0
LEARNHOUSE_AI_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
LEARNHOUSE_GEMINI_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE

# Optional AI and integrations
LEARNHOUSE_IS_AI_ENABLED=false
LEARNHOUSE_AI_PROVIDER=google
LEARNHOUSE_AI_BASE_URL=
LEARNHOUSE_AI_MODEL_FAST=
LEARNHOUSE_AI_MODEL_STANDARD=
LEARNHOUSE_AI_MODEL_PRO=
LEARNHOUSE_AI_EMBEDDING_PROVIDER=
LEARNHOUSE_AI_EMBEDDING_MODEL=
LEARNHOUSE_AI_EMBEDDING_DIMENSIONS=768
LEARNHOUSE_AI_IMAGE_MODEL=
LEARNHOUSE_AI_TTS_MODEL=
LEARNHOUSE_SENTRY_DSN=
LEARNHOUSE_EMAIL_PROVIDER=resend
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=staging@example.com
LEARNHOUSE_RESEND_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
LEARNHOUSE_SMTP_HOST=
LEARNHOUSE_SMTP_PORT=587
LEARNHOUSE_SMTP_USERNAME=
LEARNHOUSE_SMTP_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
LEARNHOUSE_SMTP_USE_TLS=true
LEARNHOUSE_TINYBIRD_API_URL=
LEARNHOUSE_TINYBIRD_INGEST_TOKEN=REPLACE_WITH_SECRET_MANAGER_VALUE
LEARNHOUSE_TINYBIRD_READ_TOKEN=REPLACE_WITH_SECRET_MANAGER_VALUE
LEARNHOUSE_JUDGE0_API_URL=
LEARNHOUSE_JUDGE0_CLIENT_ID=
LEARNHOUSE_JUDGE0_CLIENT_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
LEARNHOUSE_STRIPE_SECRET_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
LEARNHOUSE_STRIPE_PUBLISHABLE_KEY=
LEARNHOUSE_STRIPE_WEBHOOK_STANDARD_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
LEARNHOUSE_STRIPE_WEBHOOK_CONNECT_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
LEARNHOUSE_STRIPE_CLIENT_ID=
CLOUD_INTERNAL_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
LEARNHOUSE_PLATFORM_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
