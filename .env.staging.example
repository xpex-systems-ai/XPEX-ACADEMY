# XPeX Academy API staging placeholders. Do not put real secrets here.
GCP_PROJECT_ID="<GCP_PROJECT_ID>"
GCP_REGION=us-central1
ARTIFACT_REPOSITORY="<ARTIFACT_REPOSITORY>"
CLOUD_RUN_SERVICE="<CLOUD_RUN_SERVICE>"
CLOUD_RUN_SERVICE_ACCOUNT="<CLOUD_RUN_SA>"
CLOUD_SQL_INSTANCE="<CLOUD_SQL_INSTANCE>"
VPC_CONNECTOR="<VPC_CONNECTOR>"
STAGING_API_URL="<STAGING_API_URL>"
LEARNHOUSE_ENV=staging
LEARNHOUSE_DEVELOPMENT_MODE=false
LEARNHOUSE_TENANCY=single
LEARNHOUSE_DOMAIN="<STAGING_API_HOST>"
LEARNHOUSE_FRONTEND_DOMAIN="<STAGING_FRONTEND_ORIGIN>"
LEARNHOUSE_SSL=true
LEARNHOUSE_CONTENT_DELIVERY_TYPE=s3api
LEARNHOUSE_S3_API_BUCKET_NAME="<STAGING_BUCKET>"
# Secret Manager resource names, not secret values.
LEARNHOUSE_AUTH_JWT_SECRET_KEY_SECRET=learnhouse-auth-jwt-secret-key
LEARNHOUSE_SQL_CONNECTION_STRING_SECRET=learnhouse-sql-connection-string
LEARNHOUSE_REDIS_CONNECTION_STRING_SECRET=learnhouse-redis-connection-string
